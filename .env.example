# Opening Edge / ply-chess TTS
# None of these are required. With zero env vars the app uses free
# Microsoft Edge neural TTS, then the browser Web Speech API.
# Edge TTS needs network — it is not true offline. Web Speech is.

# --- Google Cloud TTS (primary *cloud* path when configured) ---
# Free-tier friendly: WaveNet defaults (typically 4M chars/month free)
# or Neural2 (typically 1M chars/month free). Quotas change — check
# https://cloud.google.com/text-to-speech/pricing
#
# Setup:
# 1. GCP project → enable Cloud Text-to-Speech API
# 2. Create an API key *or* a service account with TTS access
# 3. Enable billing (free monthly allowance still applies)
# 4. Set one of:
# GOOGLE_CLOUD_TTS_API_KEY=
# GOOGLE_CLOUD_TTS=          # API key, or raw service-account JSON
# GOOGLE_APPLICATION_CREDENTIALS=  # path to service-account JSON

# Optional Neural2 override (defaults are WaveNet):
# GOOGLE_TTS_VOICE_ALDRIC=en-GB-Neural2-B
# GOOGLE_TTS_VOICE_KAEL=en-US-Neural2-J
# GOOGLE_TTS_VOICE_SOREN=en-GB-Neural2-D
# GOOGLE_TTS_VOICE_RHEA=en-US-Neural2-F
# GOOGLE_TTS_VOICE_SILAS=en-US-Neural2-D
# GOOGLE_TTS_VOICE_LENA=en-US-Neural2-C

# --- Optional ElevenLabs (premium character voices) ---
# Used only when a key is set AND the lesson asks for dual-master characters.
# Stock library IDs only — never celebrity / likeness clones.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ALDRIC=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_VOICE_KAEL=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_VOICE_SOREN=onwK4e9ZLuTAKqWW03F9
# ELEVENLABS_VOICE_RHEA=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_VOICE_SILAS=TxGEqnHWrfWFTfGW9XjX
# ELEVENLABS_VOICE_LENA=21m00Tcm4TlvDq8ikWAM

# --- Edge TTS voice overrides (free neural path) ---
# EDGE_TTS_VOICE_ALDRIC=en-GB-RyanNeural
# EDGE_TTS_VOICE_KAEL=en-US-GuyNeural
# EDGE_TTS_VOICE_SOREN=en-GB-ThomasNeural
# EDGE_TTS_VOICE_RHEA=en-US-AriaNeural
# EDGE_TTS_VOICE_SILAS=en-US-ChristopherNeural
# EDGE_TTS_VOICE_LENA=en-US-JennyNeural

# Generic override for the active provider:
# TTS_VOICE_ALDRIC=
# TTS_VOICE_KAEL=
# TTS_VOICE_SOREN=
# TTS_VOICE_RHEA=
# TTS_VOICE_SILAS=
